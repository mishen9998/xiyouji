# Copy to .env.cloud on the VPS and replace every placeholder.
# Use a fixed sha-* image tag produced by .github/workflows/release-image.yml.
APP_IMAGE=ghcr.io/mishen9998/xiyouji:sha-replace-with-git-sha

DB_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-64-random-hex-characters

# The application stays on loopback. Put Caddy/Nginx in front for HTTPS/WSS.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
CORS_ORIGINS=https://demo.example.com
PUBLIC_BASE_URL=https://demo.example.com
