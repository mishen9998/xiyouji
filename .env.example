# Copy to .env for local Compose runs and replace every change-me value.
DB_USERNAME=root
DB_PASSWORD=change-me-in-dev
JWT_SECRET=replace-with-at-least-32-random-bytes
GRAFANA_ADMIN_PASSWORD=change-me-in-dev
ENFORCE_JWT=true
# Include Vite dev server during local development; replace with real domains in production.
CORS_ORIGINS=http://localhost:8080,http://localhost,http://localhost:5173,http://127.0.0.1:5173
# Cloud scripts only: the externally reachable URL printed after deployment.
# PUBLIC_BASE_URL=https://game.example.com

# Optional distributed performance tuning.
# TRACING_SAMPLING_PROBABILITY=0.1
# DB_POOL_MAX_SIZE=20
# DB_POOL_MIN_IDLE=5
# REDIS_POOL_MAX_ACTIVE=16
# REDIS_POOL_MAX_IDLE=8
# REDIS_POOL_MIN_IDLE=2
