# Add inside the existing HTTPS server block managed by BaoTa.
# Replace its conflicting location / block; preserve certificate configuration.
# Application must remain bound to host loopback. Run nginx -t before reload.
location ~ ^/(actuator|swagger-ui|v3/api-docs|api/instance)([/.]|$) {
    return 404;
}
location / {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
}
