# ====== 西游记项目环境变量配置 ======
# 复制此文件为 .env 并修改对应值

# ====== 数据库配置 ======
DB_PASSWORD=123456
DB_URL=jdbc:mysql://localhost:3306/xiyouji?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root

# ====== JWT 配置 ======
# 生产环境（ENFORCE_JWT=true）必须替换为强随机密钥（>=32字节），否则启动会失败
# 开发环境可使用默认值（不设置则自动使用内置默认密钥）
JWT_SECRET=xiyouji-secret-key-for-jwt-token-generation-must-be-at-least-256-bits-long
JWT_EXPIRATION=86400000

# ====== 安全配置 ======
# 设为 true 强制所有游戏 API 需要 JWT 认证（生产环境必须为 true）
# 注意：ENFORCE_JWT=true 时还会自动收口 H2 控制台、强制 JWT_SECRET 不能为默认值
ENFORCE_JWT=false

# ====== CORS 配置 ======
# 多个源用逗号分隔
CORS_ORIGINS=http://localhost:8080,http://localhost:8081,http://localhost:8082,http://localhost:80,http://127.0.0.1:8080

# ====== Redis 配置 ======
REDIS_HOST=localhost
REDIS_PORT=6379

# ====== 应用配置 ======
# Spring Profile: dev / standalone / prod / distributed / instance1 / instance2
SPRING_PROFILES_ACTIVE=dev
